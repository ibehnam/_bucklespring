<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rendered by plugin.sh into ~/Library/LaunchAgents. Everything that changes at
  runtime lives in the settings file, so this changes only when a path does.
  KeepAlive restarts a crash, never a clean exit: SIGTERM (a Stop, bootout, or
  core teardown) exits 0 and stays down. StandardErrorPath catches output from
  before the daemon rotates and opens its own log.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@LABEL@</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BUCKLE@</string>
		<string>--log</string>
		<string>@LOG@</string>
		<string>--pidfile</string>
		<string>@PIDFILE@</string>
		<string>--settings</string>
		<string>@SETTINGS@</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@DIR@</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardErrorPath</key>
	<string>@LOG@</string>
</dict>
</plist>
